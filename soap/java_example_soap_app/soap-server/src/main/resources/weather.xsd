<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="https://example.com/weather"
           targetNamespace="https://example.com/weather"
           elementFormDefault="qualified">

    <xs:complexType name="WeatherInfo">
        <xs:sequence>
            <xs:element name="city" type="xs:string"/>
            <xs:element name="temperature" type="xs:int"/>
            <xs:element name="condition" type="xs:string"/>
            <xs:element name="humidity" type="xs:int"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="getWeatherRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="city" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="getWeatherResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="weatherInfo" type="tns:WeatherInfo"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="updateTemperatureRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="city" type="xs:string"/>
                <xs:element name="newTemp" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="updateTemperatureResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>